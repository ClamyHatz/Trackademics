<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GradesController"
            prefWidth="1180.0"
            prefHeight="760.0"
            minWidth="900.0"
            minHeight="600.0"
            style="-fx-background-color: #f4f7fb;">

    <top>
        <VBox spacing="16.0" style="-fx-background-color: white; -fx-border-color: transparent transparent #dfe5ec transparent;">
            <padding>
                <Insets top="22.0" right="28.0" bottom="18.0" left="28.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="14.0">
                <!-- Home button -->
                <Button text="← Home"
                        onAction="#goHome"
                        focusTraversable="false"
                        style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-text-fill: #40566f;"/>
                <Separator orientation="VERTICAL" prefHeight="28.0"/>
                <VBox spacing="2.0">
                    <!-- Grades Label -->
                    <Label fx:id= "topGradesLabel"
                            text="Grades"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #17263a;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <!-- Selection box that you choose what you are viewing by -->
                <Label fx:id="viewByComboBoxLabel" text="View by" style="-fx-font-weight: bold; -fx-text-fill: #26384d;"/>
                <ComboBox fx:id="viewByComboBox"
                          prefWidth="120.0"
                          onAction="#handleViewByChanged"/>
                <!-- Selection box that you choose which class you are viewing by -->
                <Label fx:id="classSelectionPromptLabel"
                       text="Choose Class"
                       style="-fx-font-weight: bold; -fx-text-fill: #26384d;"/>
                <ComboBox fx:id="classSelectionComboBox"
                          prefWidth="120.0"
                          onAction="#handleClassSelectionChanged"/>
                <!-- Selection box that you choose which student you are viewing by -->
                <Label fx:id="selectionPromptLabel"
                       text="Student"
                       style="-fx-font-weight: bold; -fx-text-fill: #26384d;"/>
                <ComboBox fx:id="selectionComboBox"
                          prefWidth="120.0"
                          onAction="#handleSelectionChanged"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <GridPane hgap="20.0">
            <padding>
                <Insets top="24.0" right="28.0" bottom="28.0" left="28.0"/>
            </padding>

            <VBox spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <!-- Grades Label -->
                <Label fx:id= "loggedOutLabel"
                       text="User Logged Out"
                       style="-fx-font-size: 35px; -fx-font-weight: bold; -fx-text-fill: #17263a;"/>
                <!-- Over All Grade -->
                <Label fx:id="overallGradeLabel"
                       text="Overall Grade: —"
                       style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                <!-- Table Title -->
                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="tableTitleLabel"
                           text="Grade details"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #17263a;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <!-- Table Set-Up -->
                <TableView fx:id="gradesTable"
                           editable="true"
                           VBox.vgrow="ALWAYS">
                    <!-- Table Column Set-Up -->
                    <columns>
                        <TableColumn fx:id="assignmentColumn" text="Assignment" minWidth="150.0" prefWidth="190.0"/>
                        <TableColumn fx:id="studentColumn" text="Student Name" minWidth="150.0" prefWidth="190.0"/>
                        <TableColumn fx:id="dueDateColumn" text="Due" minWidth="95.0" prefWidth="110.0"/>
                        <TableColumn fx:id="scoreColumn" text="Score" minWidth="105.0" prefWidth="120.0"/>
                        <TableColumn fx:id="weightColumn" text="Class %" minWidth="90.0" prefWidth="100.0"/>
                    </columns>
                </TableView>
            </VBox>
        </GridPane>
    </center>
</BorderPane>
