<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="AssignmentFormController"
  spacing="10.0"
  prefWidth="500.0"
  prefHeight="600.0"
  style="-fx-padding: 20;">

  <Label fx:id="formTitleLabel"
    text="Add Assignment"
    style="-fx-font-size: 24px;" />

  <Label text="Class ID" />

  <TextField fx:id="classIdField"
    promptText="Enter the class ID" />

  <Label text="Title" />

  <TextField fx:id="titleField"
    promptText="Enter the assignment title" />

  <Label text="Description" />

  <TextArea fx:id="descriptionField"
    promptText="Enter a description"
    prefRowCount="4" />

  <Label text="Due Date" />

  <DatePicker fx:id="dueDatePicker" />

  <Label text="Points Possible" />

  <TextField fx:id="pointsField"
    promptText="Enter the points possible" />

  <Label text="Status" />

  <ComboBox fx:id="statusBox"
    prefWidth="200.0" />

  <HBox spacing="10.0">

    <Button fx:id="saveButton"
      text="Save Assignment"
      onAction="#saveAssignment" />

    <Button text="Back to Assignments"
      onAction="#goBackToAssignments" />

  </HBox>

  <Label fx:id="messageLabel" />

</VBox>