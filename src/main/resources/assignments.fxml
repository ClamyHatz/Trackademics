<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="AssignmentController"
  prefWidth="800.0"
  prefHeight="500.0">

  <top>

    <VBox spacing="10.0"
      style="-fx-padding: 20;">

      <Label text="Assignments"
        style="-fx-font-size: 24px;" />

      <Label text="View assignments and their due dates." />

      <HBox spacing="10.0">

        <Label fx:id="classSelectionLabel"
          text="Course:" />

        <ComboBox fx:id="classComboBox"
          prefWidth="300.0"
          onAction="#changeClass" />

      </HBox>

    </VBox>

  </top>

  <center>

    <VBox style="-fx-padding: 0 20 0 20;">

      <TableView fx:id="assignmentTable"
        prefHeight="350.0">

        <columns>

          <TableColumn fx:id="titleColumn"
            text="Title"
            prefWidth="250.0" />

          <TableColumn fx:id="dueDateColumn"
            text="Due Date"
            prefWidth="150.0" />

          <TableColumn fx:id="pointsColumn"
            text="Points"
            prefWidth="120.0" />

          <TableColumn fx:id="statusColumn"
            text="Status"
            prefWidth="180.0" />

        </columns>

      </TableView>

    </VBox>

  </center>

  <bottom>

    <VBox spacing="10.0"
      style="-fx-padding: 20;">

      <HBox spacing="10.0">

        <Button text="Back"
          onAction="#goBack" />

        <Button fx:id="addAssignmentButton"
          text="Create Assignment"
          onAction="#openAssignmentForm" />

        <Button fx:id="editAssignmentButton"
          text="Edit Assignment"
          onAction="#editAssignment" />

        <Button fx:id="deleteAssignmentButton"
          text="Delete Assignment"
          onAction="#deleteAssignment" />

        <Button text="Log Out"
          onAction="#logout" />

      </HBox>

      <Label fx:id="messageLabel" />

    </VBox>

  </bottom>

</BorderPane>